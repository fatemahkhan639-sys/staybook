# Copy this file to .env and fill in your values.
# If MONGO_URI is empty, the server uses an in-memory MongoDB for local development.
PORT=5000
MONGO_URI=
JWT_SECRET=change-this-secret-in-production
CLIENT_URL=http://localhost:5173
# Optional: path to a local mongod binary, used instead of downloading one
# for the in-memory database (e.g. server/.mongodb-bin/bin/mongod).
MONGOMS_SYSTEM_BINARY=
